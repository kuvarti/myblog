# Frontend build-time config. Copy to `.env.production` (or set in your CI/build
# command) before `npm run build`. Vite inlines VITE_* vars into the static
# bundle at build time, so these are NOT runtime secrets.

# Backend API base URL. MUST be https:// for a GitHub Pages (https) deploy,
# otherwise the browser blocks the requests as mixed content.
VITE_API_BASE_URL=https://api.example.com/api
